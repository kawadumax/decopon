{
  name: 'decopon',
  version: '1.0.0',
  private: true,
  scripts: {
    preinstall: 'npx only-allow pnpm',
    build: 'pnpm -F core build && tsc -b tsconfig.build.json',
    'clean:build-artifacts': 'pnpm -r run clean:build-artifacts',

    // --- App (SQLite + Tauri) Development ---
    'dev:windows': 'pnpm -F @decopon/app-windows tauri dev',
    'dev:android': 'pnpm -F @decopon/app-android tauri android dev',

    // --- App (SQLite + Tauri) Build ---
    'build:windows': 'pnpm -F core build && pnpm -F @decopon/app-windows tauri build',
    'build:android': 'pnpm -F core build && pnpm -F @decopon/app-android tauri android build --target aarch64',

    // --- Web (PostgreSQL) Development ---
    'dev:web': 'concurrently -c "#93c5fd,#c4b5fd" "cd backend/axum && cargo run --bin web --no-default-features --features web" "pnpm -F web dev" --names=axum,web',
    'preview:web': 'concurrently -c "#93c5fd,#c4b5fd" "cd backend/axum && cargo run --bin web --no-default-features --features web" "pnpm -F web preview" --names=axum,web',
    'build:web': 'pnpm -F web build',

    // --- Database Utilities ---
    'db:migrate': 'cd backend/axum && cargo run -p migration -- fresh',
    'db:generate': 'cd backend/axum && sea-orm-cli generate entity -o src/entities',

    // --- Miscellaneous & Utils ---
    'core:gen-routes': 'pnpm -F core gen-routes',
    'core:storybook': 'pnpm -F core storybook',
    'lint:i18n': 'node scripts/check-i18n-keys.mjs',
    'measure:colors': 'node scripts/measure-colors.mjs',
    'sites:build': 'pnpm -F @decopon/sites build',

    // --- Android Specific Debugging ---
    'android:debug:install:wifi': 'node scripts/android-wifi-install.mjs',
    'android:debug:install:wifi:latest': 'node scripts/android-wifi-install-latest.mjs',
    'android:debug:install:usb': 'node scripts/android-usb-install.mjs',
    'android:adb:connect:wifi': 'node scripts/android-adb-wifi-connect.mjs',
    'android:halt': 'node scripts/android-halt.mjs',

    // --- Versioning hooks ---
    'version:sync': 'node ./scripts/sync-version.mjs',
    'preandroid:build': 'pnpm version:sync',
    'prewindows:build': 'pnpm version:sync'
  },
  packageManager: 'pnpm@10.18.2',
  dependencies: {
    react: 'catalog:',
    'react-dom': 'catalog:',
    zustand: '^4.5.7',
    'unist-util-visit': '^5.0.0',
  },
  devDependencies: {
    '@biomejs/biome': '^1.9.4',
    '@types/node': '^22.15.21',
    '@types/react': 'catalog:',
    '@types/react-dom': 'catalog:',
    concurrently: '^9.1.2',
    depcheck: '^1.4.7',
    esbuild: '^0.25.2',
    tailwindcss: 'catalog:',
    typescript: 'catalog:',
    vite: 'catalog:',
  },
  pnpm: {
    overrides: {
      axios: '^1.12.0',
      'brace-expansion': '2.0.2',
      devalue: '^5.4.2',
      'form-data': '^4.0.4',
      'vite@^5.0.0': '5.4.21',
      'vite@^6.0.0': '6.4.1',
    },
  },
}
